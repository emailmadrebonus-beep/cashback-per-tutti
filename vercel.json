{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/rete", "permanent": false },
    { "source": "/cashback", "destination": "/collaboratori", "permanent": false }
  ],
  "rewrites": [
    { "source": "/rete", "destination": "/rete.html" },
    { "source": "/network", "destination": "/network.html" },
    { "source": "/collaboratori", "destination": "/collaboratori.html" },
    { "source": "/thankyou", "destination": "/thankyou.html" },
    { "source": "/thankyounetwork", "destination": "/thankyounetwork.html" },
    { "source": "/thankyoucashback", "destination": "/thankyoucashback.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/termini", "destination": "/termini.html" }
  ],
  "headers": [
    {
      "source": "/metodoalcontrario/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
